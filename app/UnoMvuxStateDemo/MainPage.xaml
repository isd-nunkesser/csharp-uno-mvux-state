<Page x:Class="UnoMvuxStateDemo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoMvuxStateDemo"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="24">
    <StackPanel
      Spacing="16"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">
      <TextBlock
        Text="Shared Counter Demo"
        FontSize="28"
        FontWeight="Bold"
        HorizontalAlignment="Center" />

      <TextBlock
        x:Name="CountText"
        Text="Count: 0"
        FontSize="36"
        FontWeight="Bold"
        HorizontalAlignment="Center" />

      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <Button Content="Increment" Click="OnIncrementClicked" />
        <Button Content="Decrement" Click="OnDecrementClicked" />
        <Button Content="Reset" Click="OnResetClicked" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
